{
  "name": "mods-manager",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "ajv": "^6.12.6",
    "cross-env": "^5.2.1",
    "file-saver": "^2.0.5",
    "flow-bin": "^0.80.0",
    "memoize-one": "^3.1.1",
    "npm": "^9.7.2",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-redux": "^5.1.2",
    "react-scripts": "3.4.4",
    "redux": "^4.0.5",
    "redux-thunk": "^2.3.0"
  },
  "scripts": {
    "gac:teams": "node scripts/findGacTeams.mjs",
    "gac:import": "node scripts/importSwgohTierList.mjs",
    "gac:test": "node scripts/testGacTeams.mjs && node scripts/testGacVariants.mjs && node scripts/testGacDeployment.mjs && node scripts/testSwgohTierList.mjs",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider HTTPS=true react-scripts start",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "postbuild": "node scripts/replace-service-worker.js",
    "test": "cross-env CI=true react-scripts test --env=jsdom --coverage",
    "eject": "cross-env react-scripts eject",
    "lint": "node node_modules/eslint/bin/eslint.js --config node_modules/eslint-config-react-app/index.js",
    "flow": "flow",
    "meta:compile": "npm run meta:compile-targets && npm run meta:compile-ranking && npm run meta:compile-secondaries",
    "meta:compile-secondaries": "node scripts/compileCharacterSecondaryPreferences.mjs",
    "meta:integrate": "node scripts/applyMetaIntegration.mjs",
    "meta:update": "npm run meta:compile && npm run meta:integrate",
    "meta:compile-targets": "node scripts/compileMetaProfiles.mjs",
    "meta:compile-ranking": "node scripts/compileMetaSpeedRanking.mjs",
    "meta:speed-integrate": "node scripts/applyMetaSpeedOrdering.mjs",
    "meta:test-top-two": "node scripts/testTopTwoMeta.mjs",
    "optimizer:ship-test": "node scripts/testShipPreference.mjs",
    "optimizer:shopping-test": "node scripts/testModShoppingList.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
